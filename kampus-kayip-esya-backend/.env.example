# ═══════════════════════════════════════════════════
# Docker Compose Environment Variables
# Bu dosyayı .env olarak kopyalayın ve değerleri güncelleyin:
#   cp .env.example .env
# ═══════════════════════════════════════════════════

# MySQL
DB_USERNAME=root
DB_PASSWORD=123456

# JWT — Production'da mutlaka değiştirin (min 256-bit)
JWT_SECRET=YediTepeUniversitesiKampusKayipEsyaUygulamasiGizliAnahtar2024SecretKey

# CORS — Production frontend domain (örn: https://kampus.yeditepe.edu.tr)
CORS_ALLOWED_ORIGIN=

# Flyway — Production'da aktif edilmeli
FLYWAY_ENABLED=false
DDL_AUTO=update
