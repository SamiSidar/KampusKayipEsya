# ═══════════════════════════════════════════════════
# Docker Compose Environment Variables
# Bu dosyayi .env olarak kopyalayin ve degerleri guncelleyin:
#   cp .env.example .env
# ═══════════════════════════════════════════════════

# MySQL
DB_USERNAME=root
DB_PASSWORD=123456

# JWT — ZORUNLU. Production'da mutlaka degistirin (min 32 karakter / 256-bit)
# Bu degeri set etmeden uygulama baslamaz.
JWT_SECRET=DevOnly_YediTepe_TestKey_2024_MinimumUzunluk32Karakter

# Gmail SMTP — Email dogrulama icin
# Google Hesap > Guvenlik > 2 Adimli Dogrulama > Uygulama Sifreleri
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
